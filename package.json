{
  "name": "atendimento-despachante",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:worker": "npm run dev -w worker",
    "build:web": "npm run build -w web",
    "build:worker": "npm run build -w worker",
    "typecheck": "npm run typecheck -w @despachante/shared && npm run typecheck -w worker && npm run typecheck -w web"
  },
  "engines": {
    "node": ">=20"
  }
}
